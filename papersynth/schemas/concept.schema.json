{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papersynth.dev/schemas/concept.schema.json",
  "title": "ConceptCluster",
  "type": "object",
  "properties": {
    "cluster_id": { "type": "string", "pattern": "^cnc_[a-z0-9_]+$" },
    "canonical_name": { "type": "string", "minLength": 1 },
    "concept_type": {
      "type": "string",
      "enum": [
        "algorithm",
        "equation",
        "hyperparameter",
        "dataset",
        "component",
        "result",
        "assumption",
        "method"
      ]
    },
    "member_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/claim_id" }
    },
    "symbol_aliases": { "type": "array", "items": { "type": "string" } },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/paper_id" }
    },
    "agreement": {
      "type": "string",
      "enum": ["unanimous", "majority", "conflicting", "singleton"]
    },
    "split_check": { "$ref": "common.schema.json#/$defs/check_result" }
  },
  "required": [
    "cluster_id",
    "canonical_name",
    "concept_type",
    "member_claims",
    "papers",
    "agreement",
    "split_check"
  ],
  "additionalProperties": false
}
