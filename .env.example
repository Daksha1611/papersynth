# Copy to .env and fill in. Never commit .env.
#
# Provider chain: free tiers only, tried in order. Groq is the workhorse;
# Gemini is a genuinely independent second quota; OpenRouter is an optional
# third bucket. No paid model is configured anywhere in this chain, so a run
# cannot spend money. If every leg is exhausted on a given day, the run pauses
# and resumes once quotas reset rather than failing.
PAPERSYNTH_PROVIDER_CHAIN=groq,gemini
PAPERSYNTH_TEMPERATURE=0

# console.groq.com - no card required
GROQ_API_KEY=
# Verify with `papersynth models` - free lineups rotate without notice.
PAPERSYNTH_GROQ_MODEL=openai/gpt-oss-120b
PAPERSYNTH_GROQ_RPD_LIMIT=1000

# aistudio.google.com - no card required
GOOGLE_API_KEY=
PAPERSYNTH_GEMINI_MODEL=gemini-2.5-flash
PAPERSYNTH_GEMINI_RPD_LIMIT=1500

# Optional third free bucket. Leave unset and 'openrouter' in the chain is
# skipped silently - no missing-key crash.
# OpenRouter's :free lineup rotates; a model ID valid today can be delisted in
# weeks. Check openrouter.ai/models?max_price=0 rather than assuming.
# OPENROUTER_API_KEY=
# PAPERSYNTH_OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# PAPERSYNTH_OPENROUTER_RPD_LIMIT=50

# Fully offline path (Ollama's OpenAI-compatible endpoint). Zero rate limits.
# PAPERSYNTH_PROVIDER_CHAIN=vllm
# PAPERSYNTH_VLLM_URL=http://localhost:11434/v1
# PAPERSYNTH_VLLM_MODEL=qwen2.5:14b

PAPERSYNTH_GROBID_URL=http://localhost:8070
PAPERSYNTH_WORKSPACE=./runs
PAPERSYNTH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Call-volume controls. Defaults here are the dev profile; raise
# SELF_CONSISTENCY_N to 3 only for a final, reviewed run.
PAPERSYNTH_SELF_CONSISTENCY_N=1
PAPERSYNTH_VERIFY_BATCH_SIZE=10
PAPERSYNTH_CACHE_BY_PROMPT_HASH=true

PAPERSYNTH_ALIGN_THRESHOLD=0.82
PAPERSYNTH_MAX_PARALLEL_PAPERS=3
PAPERSYNTH_POLICY=config/reconcile_policy.yaml
